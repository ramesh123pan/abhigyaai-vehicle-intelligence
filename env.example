# Copy this file to .env and replace placeholders with local values.
# Never commit .env or place real credentials in this example file.

PORT=4173
REQUEST_TIMEOUT_MS=30000
REQUEST_BODY_LIMIT_BYTES=2097152
KEEP_ALIVE_TIMEOUT_MS=5000
HEADERS_TIMEOUT_MS=10000
SESSION_SECRET=replace-with-a-long-random-production-secret
# Local testing: start Redis on 127.0.0.1:6379 and keep this URL.
# See REDIS_LOCAL_TESTING.md for Docker Desktop instructions.
# Production: use a managed/persistent Redis URL for shared BullMQ state.
# The same SESSION_SECRET must be configured on every web instance.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=lorryinfo
WAY2API_BASE_URL=https://app.way2api.com/api/v1
WAY2API_API_KEY=your_way2api_api_key
LORRYINFO_API_KEY=your_lorryinfo_api_key
PASSWORD_PEPPER=your_random_server_secret

# External RC queue. Redis enables durable BullMQ jobs and shared rate limits.
EXTERNAL_QUEUE_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
EXTERNAL_QUEUE_WAIT_MS=8000
EXTERNAL_QUEUE_DEADLINE_MS=30000
EXTERNAL_QUEUE_MAX_WAITING=500
